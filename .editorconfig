# Editor settings shared by all editors (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cpp,h,ino}]
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

# Generated sources: keep whatever the generator wrote.
[Smartwatch/src/assets/**]
trim_trailing_whitespace = unset
max_line_length = unset

[*.{csv,bat,cmd}]
end_of_line = unset
